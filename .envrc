watch_file om.yaml
if has om; then
  # Prefer the locally installed omnix; upstream HEAD is often not yet in the binary cache.
  om develop --stage=pre-shell || exit 1
  use flake . --accept-flake-config
  om develop --stage=post-shell
else
  source_url https://raw.githubusercontent.com/juspay/omnix/75ed48923835963e2f18baba08f54a8adc307ba2/omnixrc "sha256-8C2Jb5bHx/0cvm1+9gOlBEdWzbikCWT5UsJWewUAFt4="
  use omnix
fi
